# ======================================================================
#  Kitap Tanıtım Sitesi - Apache yapılandırması (cPanel/GüzelHosting)
# ======================================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Alt klasörde kuruluysa aşağıdaki satırın başındaki # işaretini kaldırıp
    # klasör adını yazın. Örn: RewriteBase /site/
    # RewriteBase /

    # Gerçek dosya veya klasörlere dokunma
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Kitap detay sayfası: /kitap/{slug}  ->  product.php?slug={slug}
    RewriteRule ^kitap/([A-Za-z0-9_-]+)/?$ product.php?slug=$1 [QSA,L]
</IfModule>

# Hassas dosyalara doğrudan erişimi engelle
<FilesMatch "^(config\.php|config\.sample\.php|install\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Basit güvenlik başlıkları
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
